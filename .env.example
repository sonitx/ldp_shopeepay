# Sao chép thành .env khi chạy local. Khi deploy, khai báo các biến này trong
# Netlify > Site configuration > Environment variables (scope: Functions).

# URL chính thức của website, không có dấu / ở cuối
SITE_URL=http://localhost:3000

# Telegram bot nhận thông báo khách hàng đăng ký
TELEGRAM_BOT_TOKEN=
# Một hoặc nhiều chat id, cách nhau bằng dấu phẩy (lấy bằng `npm run telegram:chat-id`)
TELEGRAM_CHAT_ID=

# Kết nối database (khi cần), ví dụ Neon/Supabase Postgres
# DATABASE_URL=
