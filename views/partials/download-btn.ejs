<%# Nút "Tải ứng dụng". Tham số: placement (bắt buộc), size ('sm' | 'lg' | 'xl'), variant ('light') %>
<a class="btn btn-download<%= typeof size !== 'undefined' && size ? ' btn-' + size : '' %><%= typeof variant !== 'undefined' && variant ? ' btn-download-' + variant : '' %>"
   href="<%= site.appDownload.url %>" target="_blank" rel="noopener sponsored" data-download="<%= placement %>">
  <svg class="btn-icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M12 3a1 1 0 0 1 1 1v9.59l3.3-3.3a1 1 0 1 1 1.4 1.42l-5 5a1 1 0 0 1-1.4 0l-5-5a1 1 0 1 1 1.4-1.42l3.3 3.3V4a1 1 0 0 1 1-1zM5 19h14a1 1 0 1 1 0 2H5a1 1 0 1 1 0-2z"/></svg>
  <span><%= site.appDownload.label %></span>
</a>
