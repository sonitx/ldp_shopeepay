<article class="post-card">
<% if (post.image) { %>
  <a href="<%= post.url %>" tabindex="-1" aria-hidden="true"><img class="post-card-image" src="<%= post.image %>" alt="" width="1200" height="630" loading="lazy" decoding="async"></a>
<% } %>
  <h3><a href="<%= post.url %>"><%= post.title %></a></h3>
  <p class="post-meta">
    <time datetime="<%= post.date.toISOString() %>"><%= formatDate(post.date) %></time>
    · <%= post.readingTime %> phút đọc
  </p>
  <p><%= post.description %></p>
<% if (post.tags.length) { %>
  <p class="tags">
<% post.tags.forEach(function (tag) { %>
    <a class="tag" href="/blog/tags/<%= tag.slug %>">#<%= tag.name %></a>
<% }) %>
  </p>
<% } %>
</article>
